{
  "version": 2,
  "specification": "design/README.md",
  "tokenSource": "design/tokens.json",
  "components": [
    {
      "id": "ReaderScreen",
      "nativeOwners": [
        "JustMarkdown/ReaderScreen.swift"
      ],
      "owns": [
        "Home",
        "OutlineNavigator",
        "DocumentSurface",
        "FloatingActions",
        "QuestionPanel",
        "ModelSettings",
        "ModelConfigurationPrompt",
        "DocumentClose",
        "ModelDataConsentPrompt"
      ],
      "invariants": [
        "One native screen coordinates the document surface and shared reading controls."
      ],
      "specification": "design/README.md#布局与适配"
    },
    {
      "id": "Home",
      "nativeOwners": [
        "JustMarkdown/ReaderScreen.swift"
      ],
      "owns": [
        "RecentDocuments",
        "PrivacyPolicy"
      ],
      "invariants": [
        "One ordered collection determines the central homepage layout and entrance sequence; the policy entry occupies its own footer."
      ],
      "specification": "design/README.md#首页与最近文档"
    },
    {
      "id": "RecentDocuments",
      "nativeOwners": [
        "JustMarkdown/RecentDocumentsView.swift",
        "JustMarkdown/RecentDocuments.swift"
      ],
      "invariants": [
        "The sheet and popover share the same list and successfully opened original-file records."
      ],
      "specification": "design/README.md#首页与最近文档"
    },
    {
      "id": "DocumentSurface",
      "nativeOwners": [
        "JustMarkdown/ReaderWebView.swift"
      ],
      "webOwners": [
        "JustMarkdown/WebSource/reader.html",
        "JustMarkdown/WebSource/reader.js",
        "JustMarkdown/WebSource/reader.css",
        "JustMarkdown/WebSource/native.css"
      ],
      "selector": "[data-component='DocumentSurface']",
      "owns": [
        "SelectionQuestionMenu",
        "SourceHistory"
      ],
      "uses": [
        "RichText"
      ],
      "invariants": [
        "Preview, source and outline derive from one working Markdown buffer."
      ],
      "specification": "design/README.md#阅读与源码"
    },
    {
      "id": "OutlineNavigator",
      "nativeOwners": [
        "JustMarkdown/ReaderScreen.swift"
      ],
      "webOwners": [
        "JustMarkdown/WebSource/reader.js",
        "JustMarkdown/WebSource/reader.css"
      ],
      "selector": "[data-component='OutlineNavigator']",
      "owns": [
        "OutlineRow"
      ],
      "invariants": [
        "Expanded and collapsed states reuse one native toggle and reserve no document width when collapsed.",
        "Automatic following scrolls only the outline pane and yields to manual outline browsing."
      ],
      "specification": "design/README.md#目录导航"
    },
    {
      "id": "OutlineRow",
      "webOwners": [
        "JustMarkdown/WebSource/reader.js",
        "JustMarkdown/WebSource/reader.css"
      ],
      "selector": "[data-component='OutlineRow']",
      "invariants": [
        "All rows share one leading control geometry and one layer of interaction feedback."
      ],
      "specification": "design/README.md#目录导航"
    },
    {
      "id": "FloatingActions",
      "nativeOwners": [
        "JustMarkdown/ReaderScreen.swift"
      ],
      "invariants": [
        "Both document modes reuse the same AI, mode-switch and More controls; source history actions join this group."
      ],
      "specification": "design/README.md#阅读与源码"
    },
    {
      "id": "SelectionQuestionMenu",
      "nativeOwners": [
        "JustMarkdown/ReaderWebView.swift"
      ],
      "uses": [
        "QuestionPanel"
      ],
      "invariants": [
        "One system AI action forwards the actual selection from either document mode."
      ],
      "specification": "design/README.md#ai-对话"
    },
    {
      "id": "QuestionPanel",
      "webOwners": [
        "JustMarkdown/WebSource/agent/panel.html",
        "JustMarkdown/WebSource/agent/agent.js",
        "JustMarkdown/WebSource/agent/agent.css"
      ],
      "selector": "[data-component='QuestionPanel']",
      "owns": [
        "ConversationThread",
        "ConversationComposer"
      ],
      "invariants": [
        "Global and selection entries share one conversation across compact and regular presentations."
      ],
      "specification": "design/README.md#ai-对话"
    },
    {
      "id": "ConversationThread",
      "webOwners": [
        "JustMarkdown/WebSource/agent/agent.js",
        "JustMarkdown/WebSource/agent/agent.css"
      ],
      "selector": ".mdv-conversation",
      "owns": [
        "ConversationTurn"
      ],
      "invariants": [
        "Sent turns and their reference snapshots remain immutable."
      ],
      "specification": "design/README.md#ai-对话"
    },
    {
      "id": "ConversationComposer",
      "nativeOwners": [
        "JustMarkdown/NativeComposerHost.swift",
        "JustMarkdown/ConversationInput.swift"
      ],
      "webOwners": [
        "JustMarkdown/WebSource/native-agent.js",
        "JustMarkdown/WebSource/agent/agent.js",
        "JustMarkdown/WebSource/agent/agent.css"
      ],
      "selector": ".mdv-composer",
      "owns": [
        "ContextAttachment"
      ],
      "invariants": [
        "One draft and its next-turn reference share the native input bridge."
      ],
      "specification": "design/README.md#引用与输入"
    },
    {
      "id": "ContextAttachment",
      "webOwners": [
        "JustMarkdown/WebSource/agent/agent.js",
        "JustMarkdown/WebSource/agent/agent.css"
      ],
      "selector": ".mdv-composer-reference",
      "uses": [
        "RichText"
      ],
      "invariants": [
        "Selection references preserve the complete selected content and its original structural relationships."
      ],
      "specification": "design/README.md#引用与输入"
    },
    {
      "id": "ConversationTurn",
      "webOwners": [
        "JustMarkdown/WebSource/agent/agent.js",
        "JustMarkdown/WebSource/agent/agent.css"
      ],
      "selector": ".mdv-turn",
      "owns": [
        "RequestStatus",
        "DocumentChange"
      ],
      "uses": [
        "RichText"
      ],
      "invariants": [
        "Each turn owns its rendered content, references, anchors and request status."
      ],
      "specification": "design/README.md#ai-对话"
    },
    {
      "id": "RequestStatus",
      "webOwners": [
        "JustMarkdown/WebSource/agent/agent.js",
        "JustMarkdown/WebSource/agent/agent.css"
      ],
      "selector": "[data-component='RequestStatus']",
      "invariants": [
        "Only the latest failed turn can replace its answer through an explicit retry."
      ],
      "specification": "design/README.md#请求反馈"
    },
    {
      "id": "DocumentChange",
      "webOwners": [
        "JustMarkdown/WebSource/agent/agent.js",
        "JustMarkdown/WebSource/agent/agent.css"
      ],
      "selector": ".mdv-proposal",
      "invariants": [
        "Cards represent applied document edits and their current save and history state."
      ],
      "specification": "design/README.md#ai-对话"
    },
    {
      "id": "RichText",
      "webOwners": [
        "JustMarkdown/WebSource/reader.js",
        "JustMarkdown/WebSource/agent/agent.js"
      ],
      "selector": ".mdv-rich-text",
      "invariants": [
        "Content surfaces share the parser, sanitizer and offline extensions.",
        "Message and reference anchors are scoped to their own rendered content."
      ],
      "specification": "design/README.md#文档渲染范围"
    },
    {
      "id": "ModelSettings",
      "nativeOwners": [
        "JustMarkdown/ModelSettingsView.swift",
        "JustMarkdown/ModelSelectionView.swift"
      ],
      "invariants": [
        "One native modal owns settings navigation and blocks the underlying reader."
      ],
      "specification": "design/README.md#模型设置与系统提示"
    },
    {
      "id": "ModelConfigurationPrompt",
      "nativeOwners": [
        "JustMarkdown/ReaderScreen.swift",
        "JustMarkdown/ReaderSession.swift"
      ],
      "invariants": [
        "Configuration resumes the original AI entry only for the same document and never submits a question."
      ],
      "specification": "design/README.md#请求反馈"
    },
    {
      "id": "DocumentClose",
      "nativeOwners": [
        "JustMarkdown/ReaderScreen.swift",
        "JustMarkdown/ReaderSession.swift"
      ],
      "invariants": [
        "Returning home follows successful document closure or explicit discard after a failed save."
      ],
      "specification": "design/README.md#模型设置与系统提示"
    },
    {
      "id": "SourceHistory",
      "nativeOwners": [
        "JustMarkdown/ReaderWebView.swift"
      ],
      "webOwners": [
        "JustMarkdown/WebSource/source-history.js",
        "JustMarkdown/WebSource/native-bridge.js"
      ],
      "selector": ".mdv-source-editor",
      "invariants": [
        "Typing, composition, paste, AI transactions, touch controls and keyboard shortcuts share one undo and redo history."
      ],
      "specification": "design/README.md#阅读与源码"
    },
    {
      "id": "PrivacyPolicy",
      "nativeOwners": [
        "JustMarkdown/PrivacyPolicyView.swift"
      ],
      "webOwners": [
        "JustMarkdown/WebSource/privacy.html"
      ],
      "invariants": [
        "One quiet homepage entry presents the bundled policy in the App language without reader state, JavaScript or remote resources."
      ],
      "specification": "design/README.md#首页与最近文档"
    },
    {
      "id": "ModelDataConsentPrompt",
      "nativeOwners": [
        "JustMarkdown/ReaderScreen.swift",
        "JustMarkdown/ReaderSession.swift",
        "JustMarkdown/ModelDataConsent.swift"
      ],
      "invariants": [
        "The first send to each service requires explicit native approval; cancellation preserves the draft and reference without starting a request."
      ],
      "specification": "design/README.md#ai-对话"
    }
  ]
}
